            <gradient
                android:startX="32"
                android:startY="26"
                android:endX="76"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#2563EB" />
                <item android:offset="0.5" android:color="#0284C7" />
                <item android:offset="1.0" android:color="#06B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Shield Dark Inset -->
    <path
        android:pathData="M54,30 L72,37 C72,54 63,68 54,75 C45,68 36,54 36,37 Z"
        android:fillColor="#090D1A" />

    <!-- Stylized Play / Reels triangle -->
    <path
        android:pathData="M48,42 L64,52 L48,62 Z"
        android:fillColor="#38BDF8" />

    <!-- Distinct Barrier Slash representing Blocker Shield -->
    <path
        android:pathData="M40,66 L68,38"
        android:strokeWidth="3.5"
        android:strokeColor="#F43F5E"
        android:strokeLineCap="round" />

    <!-- Border highlight -->
    <path
        android:pathData="M54,26 L76,34 C76,56 66,72 54,80 C42,72 32,56 32,34 Z"
